@app.post("/api/select-sheet")
async def select_sheet(request: QueryRequest):
    global current_data
    if "all_sheets" not in current_data:
        raise HTTPException(status_code=400, detail="No Excel file loaded")
    sheet_name = request.question
    if sheet_name not in current_data["all_sheets"]:
        raise HTTPException(status_code=400, detail=f"Sheet '{sheet_name}' not found")
    df = current_data["all_sheets"][sheet_name]
    df = clean_df(df)
    df = detect_dates(df)
    stats = get_stats(df)
    charts = make_charts(df)
    insights = get_insights(df, stats)
    current_data["df"] = df
    current_data["stats"] = stats
    num_cols = df.select_dtypes(include=[np.number]).columns.tolist()
    date_cols = [c for c in df.columns if pd.api.types.is_datetime64_any_dtype(df[c])]
    summary = {"rows":int(df.shape[0]),"columns":int(df.shape[1]),"column_names":df.columns.tolist(),
        "numeric_columns":num_cols,"categorical_columns":df.select_dtypes(include=["object"]).columns.tolist(),
        "date_columns":date_cols,"missing_values":int(df.isnull().sum().sum()),"duplicate_rows":int(df.duplicated().sum())}
    def clean(obj):
        if isinstance(obj, dict): return {k: clean(v) for k, v in obj.items()}
        elif isinstance(obj, list): return [clean(i) for i in obj]
        elif isinstance(obj, float) and (obj != obj or obj == float("inf") or obj == float("-inf")): return None
        return obj
    return clean({"filename":current_data["filename"],"sheet":sheet_name,"summary":summary,"stats":stats,"charts":charts,"insights":insights,"preview":to_json_safe(df.head(10))})

@app.post("/api/image")
async def analyse_image(file: UploadFile = File(...)):
    import base64
    api_key = os.getenv("ANTHROPIC_API_KEY")
    if not api_key:
        raise HTTPException(status_code=400, detail="ANTHROPIC_API_KEY not configured")
    contents = await file.read()
    ext = file.filename.split(".")[-1].lower()
    # Convert HEIC/HEIF to JPEG
    if ext in ["heic", "heif"]:
        from pillow_heif import register_heif_opener
        from PIL import Image
        register_heif_opener()
        img = Image.open(io.BytesIO(contents))
        buf = io.BytesIO()
        img.convert("RGB").save(buf, format="JPEG")
        contents = buf.getvalue()
        ext = "jpg"
    media_map = {"jpg":"image/jpeg","jpeg":"image/jpeg","png":"image/png","webp":"image/webp","gif":"image/gif"}
    media_type = media_map.get(ext, "image/jpeg")
    b64 = base64.standard_b64encode(contents).decode("utf-8")
    try:
        client = anthropic.Anthropic(api_key=api_key)
        msg = client.messages.create(
            model="claude-sonnet-4-5", max_tokens=2000,
            messages=[{"role":"user","content":[
                {"type":"image","source":{"type":"base64","media_type":media_type,"data":b64}},
                {"type":"text","text":"You are a data analyst and maths expert. Analyse this image. If it contains maths: solve step by step. If it contains data tables or charts: extract and summarise. If it contains financial figures: interpret them. If handwritten: transcribe and interpret. Provide: 1) What the image contains 2) Key findings 3) Your interpretation 4) Recommendations. Be clear and professional."}
            ]}]
        )
        return {"type":"image","filename":file.filename,"analysis":msg.content[0].text}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

